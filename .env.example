# Copie para .env no desenvolvimento local. Nunca coloque valores reais neste arquivo.

# MySQL 8 (local ou Railway). Formato: mysql://usuario:senha@host:porta/banco
DATABASE_URL=mysql://root:senha@localhost:3306/gaspump

# Endereço público usado nos links gerados pelo comando owner-reset.
PUBLIC_APP_URL=http://localhost:8081

# Desenvolvimento: autoriza o Expo Web local (8081) a chamar a API local (3000).
EXPO_WEB_PREVIEW_URL=http://localhost:8081
